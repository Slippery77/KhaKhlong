    },
    {
      "key": "refresh2",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login (บท 5)",
      "item": [
        {
          "name": "1.1 Login เครื่อง 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantSlug\": \"{{tenantSlug}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// login จำกัด 5 ครั้ง/นาที รอ 13 วินาทีก่อนยิงทุกครั้ง กัน 429 ตอนรันทั้ง collection",
                  "setTimeout(() => {}, 13000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"ได้ accessToken\", () => pm.expect(j.accessToken).to.be.a(\"string\"));",
                  "pm.test(\"ได้ refreshToken ยาว 43 ตัว\", () => pm.expect(j.refreshToken).to.have.lengthOf(43));",
                  "pm.collectionVariables.set(\"access\", j.accessToken);",
                  "pm.collectionVariables.set(\"refresh\", j.refreshToken);"
                ]
              }
            }
          ]
        },
