# ===== Database =====
# ชื่อ database สร้างตาม database/SETUP.md ข้อ 1
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pwa_pos
# ต้องเป็น pos_app เท่านั้น ถ้าใช้ postgres ระบบแยกข้อมูลระหว่างร้านจะไม่ทำงาน
DB_USER=pos_app
DB_PASSWORD=

# ===== JWT =====
# สุ่มเอง อย่างน้อย 32 ตัวอักษร เครื่อง dev กับ production ต้องคนละค่า
# วิธีการสร้างค่า secret key สามารถใช้คำสั่งด้านล่างใน terminal
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# ลดเป็น 15m หลัง POST /auth/refresh ใช้งานได้แล้วเท่านั้น
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_HOURS=16

# ===== App =====
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# ===== SlipOK (ตรวจสลิปโอนเงิน) =====
# ไม่ใส่ = ปิดปุ่มตรวจสลิป (ยังกดยืนยันรับเงินเองได้ตามปกติ)
# ได้จาก slipok.com หลังสร้างสาขา API — ใช้บัญชีกลางของระบบ แพ็กเกจฟรี 100 สลิป/เดือน
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=
# เปลี่ยนเป็น mock server ตอนรัน e2e เช่น http://localhost:4010
SLIPOK_BASE_URL=https://api.slipok.com
SLIPOK_TIMEOUT_MS=15000
